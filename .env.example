# ==========================================
# PhotoHub Environment Configuration
# ==========================================

# Supabase Local/Self-Hosted or Cloud
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==========================================
# Google Drive Unlimited Storage (Option B)
# ==========================================
# You can provide credentials using either individual fields (Option 1)
# or the entire Service Account JSON key string (Option 2).
# If these variables are not set, PhotoHub automatically saves to local disk (/public/uploads).

# Option 1: Individual fields
GOOGLE_SERVICE_ACCOUNT_EMAIL=photohub-storage@your-project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Option 2: Full JSON key string (convenient for Docker / Cloud platforms)
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
